# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# WhatsApp Bot Configuration (optional, for index.js)
LOG_LEVEL=silent
TYPING_WPM=180
TYPING_BASE_MS=1200
TYPING_MIN_MS=1500
TYPING_MAX_MS=8000
TYPING_JITTER=0.35

# Conversation Budget (optional)
CONVO_BUDGET_USD=1
STRICT_DOMAIN=true

# Gemini Pricing (optional)
# GEMINI_PRICING_JSON={"model_name":{"input":0.001,"output":0.002}}
