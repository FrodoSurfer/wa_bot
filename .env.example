# Studio 118 - Environment Configuration

# ===========================================
# WEB APP CONFIGURATION
# ===========================================

# Port for the web application (default: 3008)
WEBAPP_PORT=3008

# ===========================================
# WHATSAPP BOT CONFIGURATION (Optional)
# ===========================================

# Gemini API Key for AI conversations
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Preferred Gemini model (optional)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Budget per conversation in USD (default: 1)
CONVO_BUDGET_USD=1

# Log level for the bot (default: silent)
# Options: silent, fatal, error, warn, info, debug, trace
LOG_LEVEL=silent

# ===========================================
# TYPING BEHAVIOR (Optional)
# ===========================================

# Simulate human typing speed
TYPING_WPM=180
TYPING_BASE_MS=1200
TYPING_MIN_MS=1500
TYPING_MAX_MS=8000
TYPING_JITTER=0.35

# ===========================================
# SECURITY (Optional)
# ===========================================

# Strict domain validation for off-topic messages
STRICT_DOMAIN=true

# ===========================================
# NOTES
# ===========================================

# 1. For Web App only, you only need WEBAPP_PORT
# 2. For WhatsApp Bot, you need GEMINI_API_KEY
# 3. Database is created automatically in webapp/database/
# 4. Default services are loaded on first run
